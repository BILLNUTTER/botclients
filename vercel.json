{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "PORT=25780 BASE_PATH=/ pnpm --filter @workspace/nutterx-connect-portal run build",
  "outputDirectory": "artifacts/nutterx-connect-portal/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
